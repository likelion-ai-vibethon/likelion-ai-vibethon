# /api/rewrite 에서 사용하는 Gemini API 키
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PORT=4000

# true로 설정하면 /api/crawl, /api/rewrite 모두 크롤링/AI 호출 없이
# 하드코딩된 예시 응답을 즉시 반환한다 (사람인이 막혔거나 데모 중 장애 대비용)
MOCK=false

# (선택) Windows 환경에서 백신/보안 소프트웨어가 puppeteer가 자체 다운로드한
# Chrome-for-Testing 바이너리의 CDP(localhost) 통신을 막아 크롤링이
# 'Network.enable timed out'으로 멈추는 경우가 있다. 이때 시스템에 이미
# 설치된 Chrome 경로를 지정하면 puppeteer가 그 Chrome을 대신 사용한다
# (puppeteer가 이 환경변수를 자동으로 읽는다 - 코드 수정 불필요).
# 예: PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=
